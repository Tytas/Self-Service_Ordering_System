<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.app.controller.MainController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #f5f5f5;">

    <!-- ═══════════════ HEADER ═══════════════ -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 16;">
            <Label text="🍔 Food Order"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                 <Label text="Build your order"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
    <center>
        <HBox spacing="16">
            <BorderPane.margin>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </BorderPane.margin>

            <!-- ─── Left panel: catalog ─── -->
            <VBox spacing="12" prefWidth="340"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16;">

                <Label text="Catalogue"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <!-- Drinks tab -->
                <TabPane fx:id="catalogTabPane" tabClosingPolicy="UNAVAILABLE">

                    <Tab text="Drinks">
                        <VBox spacing="8" style="-fx-padding: 12;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="☕ Coffee" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                                <Label text="? ₺" style="-fx-text-fill: #7f8c8d;"/>
                                <Button text="+" onAction="#onAddDrink"
                                        userData="coffee"
                                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 4;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="💧 Water" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
                                <Label text="? ₺" style="-fx-text-fill: #7f8c8d;"/>
                                <Button text="+" onAction="#onAddDrink"
                                        userData="water"
                                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 4;"/>
                            </HBox>

                            <Separator/>

                            <!-- Decorator options -->
                            <Label text="Options"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                            <CheckBox fx:id="sugarCheck" text="+ Sugar"/>
                            <CheckBox fx:id="cremeCheck" text="+ Cream"/>
                        </VBox>
                    </Tab>

                </TabPane>
            </VBox>

            <!-- ─── Right panel: current order ─── -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16;">

                  <Label text="My Order"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <!-- List of added items -->
                <ListView fx:id="orderListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-radius: 6;"/>

                <Separator/>

                <!-- Total -->
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="Total :" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="totalLabel" text="0 ₺"
                           style="-fx-font-size: 14px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Actions -->
                <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="clearButton" text="Clear" onAction="#onClearOrder"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 8 16;"/>
                        <Button fx:id="orderButton" text="Place Order" onAction="#onConfirmOrder"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 8 16; -fx-font-weight: bold;"/>
                </HBox>

            </VBox>
        </HBox>
    </center>

    <!-- ═══════════════ STATUS BAR ═══════════════ -->
    <bottom>
        <Label fx:id="statusLabel" text="Ready"
               style="-fx-background-color: #ecf0f1; -fx-padding: 6 16; -fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
    </bottom>

</BorderPane>
